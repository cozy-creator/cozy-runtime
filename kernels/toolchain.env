# The toolchain kernels.yaml builds the modules with. It is part of their cache key (a hash of
# kernels/**), as are the sources, flags and targets: a change here rebuilds every module.
# Linux: glibc 2.28 and gcc-toolset-14, the floor the native wheels promise.
MANYLINUX=2026.10.10-1
CUDA_NVCC=13.0.88
CUDA_CUDART=13.0.96
CUDA_CUOBJDUMP=13.0.85
# Windows: NVIDIA's redistributable archives of that toolkit, and Visual Studio 2022's last MSVC
# toolset (CUDA 13.0 takes MSVC through 19.4x).
CUDA_REDIST=13.0.2
MSVC_TOOLSET=14.44
NANOBIND=3.0.1
# The CPU torch each module must load before (checks/kernel_modules.py --torch-python).
TORCH=2.14.*
CMAKE=4.4.4
NINJA=1.13.2
