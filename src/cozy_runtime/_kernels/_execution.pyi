class NativeExecutionError(RuntimeError):
    error_code: int

class ResidentRepeat:
    supports_phases: bool
    supports_event_input: bool
    supports_reusable_input: bool
    def __init__(
        self,
        source_graph: int,
        index: int,
        device: int,
        steps: int,
        owners: list[object],
        *,
        prefix_graph: int = 0,
        suffix_graph: int = 0,
    ) -> None: ...
    @property
    def body_nodes(self) -> int: ...
    def facts(self) -> dict[str, object]: ...
    def launch(self, producer_stream: int) -> int: ...
    def continuation(
        self, producer_stream: int, *, reusable: bool = False
    ) -> tuple[object, int]: ...
    def poll(self, epoch: int) -> tuple[int, bool, bool]: ...
    def cancel(self, epoch: int) -> None: ...
    def wait(self, epoch: int) -> tuple[int, bool]: ...
    def close(self, epoch: int) -> None: ...
    def close_owner(self) -> None: ...

class NativeSequence:
    def __init__(
        self, stages: list[object], device: int, repeat: tuple[int, int, int] | None = None
    ) -> None: ...
    def start(self) -> None: ...
    def cancel(self) -> None: ...
    def poll(self) -> tuple[int, bool, bool]: ...
    def wait(self) -> tuple[int, bool]: ...
    def facts(self) -> dict[str, object]: ...
    def close_owner(self) -> None: ...
